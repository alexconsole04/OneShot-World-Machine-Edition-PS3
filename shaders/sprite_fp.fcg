// sprite_fp.fcg - sprite fragment program. Must match source/platform/shade_math.h.
void main(
	float2 in_texcoord    : TEXCOORD0,
	float4 in_color       : TEXCOORD1,
	float4 in_tone        : TEXCOORD2,
	float2 in_hue         : TEXCOORD3,
	uniform sampler2D tex : TEXUNIT0,
	out float4 out_color  : COLOR)
{
	float4 t = tex2D(tex, in_texcoord);

	// Same as the game's HueShader: rotate hue about the grey axis,
	// add tone, (gamma = 1 for now), then multiply by the vertex colour.
	float cs = in_hue.x, sn = in_hue.y;
	float k = (1.0f - cs) / 3.0f;
	float q = 0.57735026f * sn;
	float3 rgb;
	rgb.r = t.r * (cs + k) + t.g * (k - q) + t.b * (k + q);
	rgb.g = t.r * (k + q) + t.g * (cs + k) + t.b * (k - q);
	rgb.b = t.r * (k - q) + t.g * (k + q) + t.b * (cs + k);
	rgb = rgb + in_tone.rgb;

	out_color = saturate(float4(rgb, t.a) * in_color);
}
