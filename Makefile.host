# Host (Linux) build: software renderer + scripted input, for screenshots/tests.
CXX ?= g++
CC ?= gcc
CXXFLAGS = -std=c++17 -O2 -g -Wall -Wextra -Wno-unused-parameter -Ithird_party -Isource -MMD -MP
CFLAGS = -O2 -g -Ithird_party -MMD -MP
# Everything but the PS3 platform code, plus the host stand-ins for it.
SRC_CPP = source/main.cpp source/test_hooks.cpp $(wildcard source/engine/*.cpp source/game/core/*.cpp source/game/world/*.cpp source/game/ui/*.cpp \
          source/game/twm/*.cpp source/game/twm/apps/*.cpp) \
          $(wildcard source/platform/*.cpp source/platform/host/*.cpp)
SRC_C = source/engine/xnb.c third_party/cJSON.c
OBJ = $(patsubst %,build-host/%.o,$(SRC_CPP) $(SRC_C))

build-host/oneshot-host: $(OBJ)
	$(CXX) $(LDFLAGS) -o $@ $^ -lm -lpthread

build-host/%.cpp.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

build-host/%.c.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf build-host/source build-host/third_party build-host/oneshot-host

-include $(OBJ:.o=.d)
