# Host (Linux) build: software renderer + scripted input, for screenshots/tests.
CXX ?= g++
CC ?= gcc
CXXFLAGS = -std=c++17 -O2 -g -Wall -Wextra -Wno-unused-parameter -Ithird_party -Isource
CFLAGS = -O2 -g -Ithird_party
SRC_CPP = source/main.cpp source/engine/gm.cpp source/engine/xml.cpp source/engine/overlay.cpp source/engine/util.cpp source/engine/audio.cpp \
          source/game/event_data.cpp source/game/entity.cpp source/game/player.cpp source/game/tilemap.cpp \
          source/game/event_runner.cpp source/game/message_box.cpp source/game/pictures.cpp source/game/script_parser.cpp \
          source/platform/host/gfx_soft.cpp source/platform/host/sys_host.cpp source/platform/host/input_host.cpp
SRC_C = source/xnb.c third_party/cJSON.c
OBJ = $(patsubst %,build-host/%.o,$(SRC_CPP) $(SRC_C))

build-host/oneshot-host: $(OBJ)
	$(CXX) -o $@ $^ -lm

build-host/%.cpp.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

build-host/%.c.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf build-host/source build-host/third_party build-host/oneshot-host
